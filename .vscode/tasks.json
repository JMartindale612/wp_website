{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Website: preview",
      "type": "shell",
      "command": "bundle",
      "args": [
        "exec",
        "jekyll",
        "serve",
        "--livereload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Website: build",
      "type": "shell",
      "command": "bundle",
      "args": [
        "exec",
        "jekyll",
        "build",
        "--trace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
