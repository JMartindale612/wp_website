source "https://rubygems.org"

# Match the Jekyll and plugin versions used by GitHub Pages.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Ruby 3 no longer bundles WEBrick, which Jekyll uses for its local server.
gem "webrick"

# Windows does not include the IANA timezone database used by Jekyll/TZInfo.
gem "tzinfo-data"
